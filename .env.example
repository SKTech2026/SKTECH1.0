DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
NEXTAUTH_URL=https://your-fresh-railway-app.up.railway.app
NEXTAUTH_SECRET=replace_with_long_random_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Email/OTP delivery
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your_gmail_address@gmail.com
EMAIL_SERVER_PASSWORD=your_gmail_app_password
EMAIL_FROM=SKTech <your_gmail_address@gmail.com>
# Optional HTTPS email delivery for Railway when SMTP is blocked or slow.
RESEND_API_KEY=replace_with_resend_api_key
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_FROM_EMAIL=noreply@example.com
BREVO_FROM_NAME=SKTech

# AI service integration
AI_SERVICE_URL=https://your-ai-service-url
FACE_SECRET=replace_with_shared_secret_used_by_ai_service

# AWS Rekognition Face Liveness
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_REKOGNITION_LIVENESS_CONFIDENCE_THRESHOLD=90
