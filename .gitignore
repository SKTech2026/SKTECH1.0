# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.venv
ai-service/.venv

# python cache / bytecode
__pycache__/
*.py[cod]

# runtime logs
*.log
ai-service/logs/

# user-uploaded runtime files
/public/uploads/

# local npm config
.npmrc

# local face training data and biometric-derived artifacts
/ai-training/data/raw/
/ai-training/data/processed/
/ai-training/models/*.pkl
/ai-training/models/*.joblib
/ai-training/reports/*.csv
/ai-training/reports/*.png
